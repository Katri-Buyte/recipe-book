        {
          "qty": 1,
          "unit": "",
          "item": "garlic clove"
        },
        {
          "qty": 30,
          "unit": "g",
          "item": "apple cider vinegar or white wine vinegar",
          "note": "about 2 tbsp"
        },
        {
          "qty": 60,
          "unit": "g",
          "item": "olive oil",
          "note": "about 4 tbsp"
        },
        {
          "qty": 0.5,
