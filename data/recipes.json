      "id": "kelaidi",
      "title": "Kelaidi, beef and pepper bake",
      "category": "mains",
      "description": "A layered tray bake from Tyrnavos: potato, horn peppers, sliced beef, tomato and kefalotyri.",
      "added": "2026-11-22",
      "servings": 7,
      "prepMinutes": 10,
      "cookMinutes": 60,
      "tags": [
        "greek",
        "high protein",
        "one tray",
        "gluten free"
      ],
      "source": {
        "name": "Giorgos Tsoulis",
        "url": "https://www.giorgostsoulis.com/syntages/kyrios-gevmata/kelaidi"
      },
      "image": "",
      "ingredients": [
        {
          "qty": 2,
          "unit": "",
          "item": "potatoes",
          "note": "cut into 3 mm rounds"
        },
        {
          "qty": 500,
          "unit": "g",
          "item": "horn peppers",
          "note": "halved"
        },
        {
          "qty": 750,
          "unit": "g",
          "item": "beef (the Greek cut \"elia\")",
          "note": "cut into 1 cm slices"
        },
        {
          "qty": 700,
          "unit": "g",
          "item": "tomatoes",
          "note": "cut into 3 mm rounds"
        },
        {
          "qty": 500,
          "unit": "g",
          "item": "kefalotyri",
          "note": "grated"
        },
        {
          "qty": "",
          "unit": "",
          "item": "olive oil, salt and pepper"
        }
      ],
      "steps": [
        "Heat the oven to 200°C, top and bottom heat. Oil the base of a 25 x 32 cm tray.",
        "Cover the base with the potato slices and season with salt and pepper.",
        "Cover the potatoes fully with the peppers and season.",
        "Lay the beef over the peppers with no gaps and season.",
        "Arrange the tomatoes on top, season, and cover the whole tray with the cheese.",
        "Bake for 1 hour. After the first 30 minutes cover the tray with foil.",
        "Let it cool slightly before serving."
      ],
      "notes": "Every layer is seasoned, so go lightly with the salt. If it releases a lot of liquid at the end, spoon it off carefully. Kcal, protein and carbs are from the source. Fat and fibre are estimated.",
